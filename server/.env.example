# ===== 学习工作台后端配置（复制为 .env 后填写；.env 不要提交到仓库）=====

# JWT 签名密钥：正式部署务必改成一段足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string
# JWT 有效期（天）
JWT_EXPIRE_DAYS=7

# SQLite 数据库文件路径（相对 server 目录）
DATABASE_PATH=data.db

# ============ 大模型 API 密钥（只存在后端，前端永远接触不到）============
# 需要启用哪个服务商，就填哪一行的 Key；不填的服务商不会出现在前端下拉框里
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# 硅基流动：内置向量 / 重排 / ASR（语音转写）模型走这条；不填则 ASR 不可用
SILICONFLOW_API_KEY=

# 火山方舟：ARK_API_KEY 一个变量同时覆盖 chat / 图片 / 视频 / 3D 四条通道
# （同一方舟账号、同一密钥；arkimage / arkvideo / ark3d 均复用它，不另设变量）
ARK_API_KEY=

# 百度千帆（内置模型 qf-ernie-* 走这条）
QIANFAN_API_KEY=

# ============ 海外免费模型（OpenRouter / Google Gemini，R132）============
# 这两家国内服务器直连不通，必须配置代理（如本机 Clash：http://127.0.0.1:7897）。
# 不配置代理时其模型仍会出现在列表里（relayAvailable=false），但服务端中转不可用，
# 由前端提示并切到用户自备 Key 本地直连。三行全部留空 = 仅用户本地直连可用。
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# 代理（可选）：平台级优先于全局；留空则这两家只能靠用户自备 Key 直连。
# OPENROUTER_PROXY=http://127.0.0.1:7897
# GEMINI_PROXY=http://127.0.0.1:7897
RELAY_PROXY_URL=

# 可选：覆盖默认接口地址（如走代理）
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# 可选：覆盖媒体通道的默认接口地址（一般不用改，留空即用火山官方地址）
# ARKIMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# ARKVIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
# ARK3D_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks

# 可选：覆盖媒体通道的默认模型名
# ARKIMAGE_MODEL=doubao-seedream-4-0-250828
# ARKVIDEO_MODEL=doubao-seedance-1-0-pro-250528
# ARK3D_MODEL=doubao-seed3d-2-0-260328

# ============ R131：客户端版本闸门（P0-9 旧 APK 优雅降级）============
# 前端在所有 /api/ai/* 请求头带 X-Client-Version；缺失或低于该值 → 返回
# {ok:false, kind:"version_outdated"}（前端渲染「请更新到最新版」提示卡）。
#
# 默认【关闭】：留空或不配这一行即不校验。因为当前线上前端尚未发送该请求头，
# 默认开启会让后端一部署就把全部 AI 能力打成「请更新」。
# 开启时机：前端改造上线、确认已发 X-Client-Version 之后，再在这里填最低版本，
# 例如：MIN_RELAY_CLIENT_VERSION=20260919q
MIN_RELAY_CLIENT_VERSION=

# 可选：覆盖默认模型名
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-plus
# KIMI_MODEL=moonshot-v1-8k
# ZHIPU_MODEL=glm-4-flash
# OPENAI_MODEL=gpt-4o-mini

# ============ R100：腾讯位置服务 WebService（后端定位代理专用）============
# /api/geo/*（IP 定位降级 / 逆地理编码 / 行政区划子级）由后端代理腾讯接口，
# Key 只存在后端 .env，前端不再显式下发；留空则三接口统一返回 {"ok":false,"error":"key_missing"}。
TENCENT_MAP_KEY=
