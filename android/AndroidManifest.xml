<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.study.workbench"
    android:versionCode="22"
    android:versionName="1.21">

    <!-- 预留：将来若连接局域网后端（多人在线模式）需要联网权限；单机离线其实用不到 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音跟读/语音输入：系统 SpeechRecognizer 需要麦克风（Android 6.0+ 运行时申请） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 需求5：系统级消息通知横幅（Android 13 / API 33+ 需运行时申请 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- R73-18①：退到后台/退出界面后仍能收到新消息 —— 前台服务（原生侧轮询未读） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- R73-18①：Android 14 (API 34) 起前台服务须声明类型，dataSync 对应轮询同步 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- R73-18①：引导用户忽略电池优化，降低后台服务被冻结/清理导致停摆的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- R73-4（需求4 根因）：Android 11+ 包可见性（package visibility）。
         targetSdkVersion>=30 时，未声明本 <queries> 的应用调用
         PackageManager.queryIntentServices(new Intent("android.intent.action.TTS_SERVICE"))
         会返回【空列表】，MainActivity 的语音引擎兜底枚举因此失效
         → 报告「本机无可用语音引擎：系统设置搜索『文字转语音』…」。
         WebView 内 speechSynthesis.getVoices() 同样拿不到引擎 → “不支持语音合成”。
         官方 TTS 文档要求目标 API 30+ 必须声明此 queries。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:label="星途"
        android:icon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- R73-18①：消息轮询前台服务 —— WebView 退后台/JS 停摆后，由原生侧轮询未读并弹系统通知 -->
        <service
            android:name=".MsgPollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
