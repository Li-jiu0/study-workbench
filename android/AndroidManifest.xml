<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.study.workbench"
    android:versionCode="45"
    android:versionName="1.44">

    <!-- 预留：将来若连接局域网后端（多人在线模式）需要联网权限；单机离线其实用不到 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音跟读/语音输入：系统 SpeechRecognizer 需要麦克风（Android 6.0+ 运行时申请） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 定位：App 内「一键定位 / 获取周边位置」需要网络定位与 GPS 定位（Android 6.0+ 需运行时申请）。
         注意：刻意【不】声明 <uses-feature android:name="android.hardware.location.gps" android:required="true">，
         否则无 GPS 硬件的设备会被应用市场判定为不兼容而无法安装；如需声明必须 required="false"。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 需求5：系统级消息通知横幅（Android 13 / API 33+ 需运行时申请 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- R73-18①：退到后台/退出界面后仍能收到新消息 —— 前台服务（原生侧轮询未读） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- R73-18①：Android 14 (API 34) 起前台服务须声明类型，dataSync 对应轮询同步 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 批5/R104e：实时位置共享前台服务 —— 声明 location 类型权限（Android 14/API34+ 强制，
         不声明会 MissingForegroundServiceTypeException 崩溃）。普通权限，安装即授予，无弹窗。
         注意：刻意【不】申请 ACCESS_BACKGROUND_LOCATION —— 共享由可见 Activity 点按发起，
         属「延续用户主动操作」（同 Google 地图导航模型），后台仍可持续定位。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- R73-18①：引导用户忽略电池优化，降低后台服务被冻结/清理导致停摆的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- R105：开机自启 —— BootReceiver 收到 BOOT_COMPLETED 后按开关+登录态拉起 MsgPollService -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- R3-L5：读取已安装应用列表（仅用于账号与设备安全风控）。
         targetSdk 33（Android 11+ 包可见性收紧）：未声明本权限时
         PackageManager.getInstalledApplications 只能看到自身与少量系统包，
         无法用于「识别多开/模拟器/异常设备」的风控指纹。声明后方可见全部包。
         ⚠️ 敏感个人信息采集：仅采集【用户手动安装的第三方应用】的 SHA-256 哈希（加盐，
         不含明文包名/应用名/图标），仅在用户同意隐私政策且「设备安全」开关开启时采集；
         严禁用于通知、用户画像或广告；响应 Google Play 与本平台《隐私政策》的合规要求。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- R73-4（需求4 根因）：Android 11+ 包可见性（package visibility）。
         targetSdkVersion>=30 时，未声明本 <queries> 的应用调用
         PackageManager.queryIntentServices(new Intent("android.intent.action.TTS_SERVICE"))
         会返回【空列表】，MainActivity 的语音引擎兜底枚举因此失效
         → 报告「本机无可用语音引擎：系统设置搜索『文字转语音』…」。
         WebView 内 speechSynthesis.getVoices() 同样拿不到引擎 → “不支持语音合成”。
         官方 TTS 文档要求目标 API 30+ 必须声明此 queries。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 需求D/R152：应用白名单原生桥包可见性。targetSdk 33（Android 11+）下，
         未声明本 <queries> 时 queryIntentActivities(MAIN/LAUNCHER) 只能看到自身，
         白名单列表会空。QUERY_ALL_PACKAGES 已另行声明，此处按规范再显式列出
         桌面启动入口意图，双保险且不与其余 queries 冲突。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />

    <application
        android:label="星途"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <!-- R105：singleTop —— 通知点击已在栈顶时走 onNewIntent 传递深链 extras，不重复开实例 -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- R73-18①：消息轮询前台服务 —— WebView 退后台/JS 停摆后，由原生侧轮询未读并弹系统通知 -->
        <service
            android:name=".MsgPollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 批5/R104e：实时位置共享前台服务 —— location 类型，独立于 MsgPollService。
             由可见 Activity 点按发起（Android 14 起须声明类型）；原生直接 POST /api/live/tick，
             切后台/熄屏后持续上报；【不】经 BootReceiver 拉起（Android 10+ 后台自动开始会被拒）。 -->
        <service
            android:name=".LocationShareService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- R105：开机自启 —— 按本地开关+登录态拉起消息轮询前台服务（受保护系统广播，仅系统可发） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 需求C：消息轮询拉活兜底 JobService —— 每 15 分钟自检 MsgPollService 是否存活，
             未跑则拉起（治「划掉最近任务后 START_STICKY 恢复不可靠」）。
             setPersisted(true) 依赖的 RECEIVE_BOOT_COMPLETED 已在上方声明；
             BIND_JOB_SERVICE 权限为系统 JobScheduler 绑定所必需。 -->
        <service
            android:name=".PollKeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- R101：应用内下载更新包自动安装 —— Android 7+ 系统安装器读 file:// 会
             FileUriExposedException，须经 content:// 授权读取。本工程零 androidx/support
             依赖（系统 API 无 FileProvider 类），故自写极简 ApkFileProvider：仅开放
             系统公共 Download 目录下的 .apk（防目录穿越），exported=false + 运行时授权。 -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.study.workbench.apkfile"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- R3b-A/B3：崩溃/错误日志导出 —— 自写极简 LogFileProvider（同 ApkFileProvider 思路，
             零 androidx）。只开放 getExternalFilesDir(null)/logs/ 目录下的 .log/.txt，
             经 content:// + FLAG_GRANT_READ_URI_PERMISSION 授权给系统分享/查看器读取，
             规避 Android 7+ 对 file:// 跨进程读的 FileUriExposedException。 -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.study.workbench.logfile"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
